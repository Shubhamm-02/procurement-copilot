# Copy to .env and fill in ONE or more keys. The agent tries providers in this
# order: Groq -> Anthropic (Claude) -> OpenAI. If none are set, the copilot runs
# in a fully deterministic mode (no LLM) and still works end-to-end.
#
# NEVER commit your .env.

# --- LLM providers (priority order) ---
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (sensible defaults are used if left blank)
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini

# Request timeout for LLM calls (seconds)
LLM_TIMEOUT_SECONDS=30

# --- Local services ---
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001
